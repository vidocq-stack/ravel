<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.ravel</groupId>
    <artifactId>ravel-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Ravel</name>
    <description>Implémentation MicroProfile Config 3.1 — zéro librairie tierce, virtual threads, Java Modules strict</description>
    <url>https://codefloe.com/Vidocq/ravel</url>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://forge.vidocq.dev/vidocq/ravel</url>
        <connection>scm:git:https://forge.vidocq.dev/vidocq/ravel.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/ravel.git</developerConnection>
    </scm>

    <properties>
        
        <microprofile.config.version>3.1.1</microprofile.config.version>

        
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        
        <vauban.version>0.4.0-RC1</vauban.version>

        
        <jmh.version>1.37</jmh.version>

        
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl ravel-tck test</ci.tck.command>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/ravel-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    
    <modules>
        <module>ravel-mp-config-api</module>
        <module>ravel-api</module>
        <module>ravel-core</module>
        <module>ravel-cdi-vauban</module>
        <module>ravel-it-other-containers</module>
        <module>ravel-bench</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>ravel-tck</module>
            </modules>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>ravel-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>