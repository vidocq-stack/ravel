<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.ravel</groupId>
    <artifactId>ravel-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ravel</name>
    <description>Implémentation MicroProfile Config 3.1 — zéro librairie tierce, virtual threads, Java Modules strict</description>
    <url>https://codefloe.com/Vidocq/ravel</url>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://forge.vidocq.dev/vidocq/ravel</url>
        <connection>scm:git:https://forge.vidocq.dev/vidocq/ravel.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/ravel.git</developerConnection>
    </scm>

    <properties>
        <!-- Spec MicroProfile Config — 3.1.1 ajoute Automatic-Module-Name (publiée 2026-04-22) -->
        <microprofile.config.version>3.1.1</microprofile.config.version>

        <!-- Specs Jakarta (uniquement utilisées par ravel-cdi-vauban) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Vidocq upstream — utilisé par ravel-cdi-vauban -->
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>

        <!-- JMH pour ravel-bench -->
        <jmh.version>1.37</jmh.version>

        <!--
            The TCK this repository's pull requests are gated on (Vidocq/GestionProjet#9). Read by
            the shared pr-validate workflow, which skips the step when this property is absent.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds ravel-tck to the reactor, and inside ravel-tck the
            `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset while
            reporting success — the vacuous gate this campaign exists to remove.

            Measured on a clean local repository (empty ~/.m2, the state of a CI runner): the
            official MicroProfile Config 3.1 TCK runs 378 tests in 3 s, all green, every artefact
            resolved from Maven Central.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl ravel-tck test</ci.tck.command>
    </properties>

    <!--
        ravel-tck joins the reactor only under the `tck` profile (see <profiles>
        below) — TCK harmonisation, same pattern as the vidocq-runtime-tck-*
        runners and the dirac pilot: a plain `mvn install` neither downloads nor
        runs anything TCK-related. The historical out-of-reactor constraint
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0 POMs) disappeared with the
        Maven 3.9.16 / Model 4.0.0 migration.
    -->
    <modules>
        <module>ravel-mp-config-api</module>
        <module>ravel-api</module>
        <module>ravel-core</module>
        <module>ravel-cdi-vauban</module>
        <module>ravel-it-other-containers</module>
        <module>ravel-bench</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--
                MicroProfile Config API — spec officielle Eclipse. N'est référencée
                directement que par 'ravel-mp-config-api' qui la repackage avec un
                module-info explicite (compatibilité jlink). Les autres modules Ravel
                doivent dépendre de 'ravel-mp-config-api' à la place.
            -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>

            <!-- MicroProfile Config API repackagée avec module-info explicite (jlink-ready) -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jakarta APIs (utilisés par ravel-cdi-vauban uniquement) -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Ravel modules internes -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <!--
            TCK harmonisation: the official MicroProfile Config 3.1 TCK runner
            joins the reactor only when this profile is active.

                ./mvnw -Ptck -pl ravel-tck test                     # smoke
                ./mvnw -Ptck,tck-official -pl ravel-tck test        # full suite

            run-official-tck-mp-config-3.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>ravel-tck</module>
            </modules>
        </profile>
    </profiles>
</project>
